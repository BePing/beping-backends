// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
generator client {
  provider     = "prisma-client"
  output       = "../libs/common/src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model Member {
  id             Int
  licence        Int
  playerCategory PlayerCategory
  firstname      String
  lastname       String
  email          String?
  ranking        String
  club           String
  category       String
  worldRanking   Int
  nationality    String

  pointsHistory     NumericPoints[]
  results           IndividualResult[] @relation("member")
  resultsAsOpponent IndividualResult[] @relation("memberopponent")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@id([id, licence])
  @@index([licence, playerCategory], name: "idx_member_licence_category")
  @@index([playerCategory, ranking], name: "idx_member_category_ranking")
  @@index([club, playerCategory], name: "idx_member_club_category")
}

enum PlayerCategory {
  SENIOR_MEN
  SENIOR_WOMEN
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model NumericPoints {
  memberId                Int
  memberLicence           Int
  date                    DateTime @default(now()) @db.Date
  member                  Member   @relation(fields: [memberId, memberLicence], references: [id, licence])
  points                  Float
  ranking                 Int?
  rankingWI               Int?
  rankingLetterEstimation String?

  @@id([memberId, memberLicence, date])
  @@index([date])
  @@index([memberLicence, date], name: "idx_numeric_points_licence_date")
}

model Competition {
  id          String             @id
  name        String
  type        CompetitionType
  coefficient Int
  results     IndividualResult[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model IndividualResult {
  id                    Int
  date                  DateTime       @default(now()) @db.Date
  playerCategory        PlayerCategory
  memberId              Int
  memberLicence         Int
  opponentId            Int
  opponentLicence       Int
  opponentRanking       String         @db.VarChar(4)
  memberRanking         String         @db.VarChar(4)
  memberPoints          Decimal?       @db.Decimal(6, 2)
  opponentPoints        Decimal?       @db.Decimal(6, 2)
  result                Result
  score                 String         @db.VarChar(3)
  competitionId         String
  competition           Competition    @relation(fields: [competitionId], references: [id])
  diffPoints            Decimal        @db.Decimal(6, 2)
  pointsToAdd           Int            @db.SmallInt
  looseFactor           Decimal        @db.Decimal(3, 2)
  definitivePointsToAdd Decimal        @db.Decimal(6, 2)
  member                Member         @relation("member", fields: [memberId, memberLicence], references: [id, licence])
  memberOpponent        Member         @relation("memberopponent", fields: [opponentId, opponentLicence], references: [id, licence])
  createdAt             DateTime       @default(now())

  @@id([id, playerCategory])
  @@index([date])
  @@index([competitionId])
  @@index([memberId, memberLicence], name: "idx_individual_result_member_identity")
  @@index([memberLicence, playerCategory, date], name: "idx_individual_result_licence_category_date")
}

enum CompetitionType {
  TOURNAMENT
  CHAMPIONSHIP
}

enum Result {
  VICTORY
  DEFEAT
}

model APIConsumer {
  id        Int      @id @default(autoincrement())
  app       String   @unique
  password  String
  updatedAt DateTime @updatedAt
}

model MobileNotificationSent {
  id               String           @id
  createdAt        DateTime         @default(now())
  sent             Boolean
  messageIds       String[]
  notificationType NotificationType
}

enum ImportType {
  MEMBER
  RESULT
}

model DataImport {
  id               Int            @id @default(autoincrement())
  type             ImportType
  playerCategory   PlayerCategory
  importedAt       DateTime       @default(now())
  hash             String // Store hashes of each line to detect changes
  fileDate         DateTime? // Date from the first line of the file (ISO-8601 format)
  linesProcessed   Int? // Number of lines processed (excluding header)
  linesAdded       Int? // Number of new records added
  linesUpdated     Int? // Number of existing records updated
  processingTimeMs Int? // Processing time in milliseconds

  @@index([type, playerCategory, importedAt])
  @@index([type, playerCategory, fileDate])
}

enum NotificationType {
  MATCH
  RANKING
  CUSTOM
  CAPTAIN_AVAILABILITY_REQUEST
  CAPTAIN_CONVOCATION
  CAPTAIN_LINEUP_REMINDER
}

model DeviceSubscription {
  id                 String              @id @default(cuid())
  userId             String? // Optional user ID for authenticated users
  deviceToken        String              @unique
  platform           DevicePlatform
  appVersion         String?
  locale             String              @default("fr")
  active             Boolean             @default(true)
  notificationTypes  NotificationType[]
  metadata           Json? // Additional device/user metadata
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  lastUsed           DateTime            @default(now())
  notificationLogs   NotificationLog[]
  topicSubscriptions TopicSubscription[]

  @@index([userId])
  @@index([active])
  @@index([platform])
}

model TopicSubscription {
  id                   String             @id @default(cuid())
  topic                String
  deviceSubscriptionId String
  deviceSubscription   DeviceSubscription @relation(fields: [deviceSubscriptionId], references: [id], onDelete: Cascade)
  createdAt            DateTime           @default(now())

  @@unique([deviceSubscriptionId, topic])
  @@index([topic])
}

model NotificationLog {
  id                   String              @id @default(cuid())
  deviceSubscriptionId String?
  notificationType     NotificationType
  title                String
  body                 String
  data                 Json? // Additional payload data
  fcmMessageId         String? // FCM response message ID
  status               NotificationStatus
  errorMessage         String?
  sentAt               DateTime            @default(now())
  deviceSubscription   DeviceSubscription? @relation(fields: [deviceSubscriptionId], references: [id], onDelete: SetNull)

  @@index([notificationType])
  @@index([status])
  @@index([sentAt])
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
}

enum NotificationOutboxType {
  PLAYER_RANKING_UPDATED
  RESULT_UPDATED
  CHALLENGE_PUBLISHED
}

enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model NotificationOutbox {
  id               String                   @id @default(cuid())
  type             NotificationOutboxType
  deduplicationKey String                   @unique
  payload          Json
  status           NotificationOutboxStatus @default(PENDING)
  attempts         Int                      @default(0)
  availableAt      DateTime                 @default(now())
  processedAt      DateTime?
  lastError        String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([status, availableAt])
  @@index([type, createdAt])
}

// ---------------------------------------------------------------------------
// Captain Mode
// New user-generated domains for the "Mode Capitaine" module. Additive only.
// Federation force-list data is NOT duplicated here; it is derived from TabT at
// request time and snapshotted onto Lineup.forceSnapshot at validation time.
// ---------------------------------------------------------------------------

enum AvailabilityStatus {
  PRESENT
  ABSENT
  PENDING
}

enum ResponseSource {
  PLAYER
  CAPTAIN_OVERRIDE
}

enum LineupStatus {
  A_FAIRE
  BROUILLON
  VALIDEE
}

enum SlotRole {
  TITULAIRE
  BANC
  RENFORT_MONTANT
}

enum ConvocationStatus {
  CONFIRMED
  DECLINED
  PENDING
}

/// A verified AFTT member authorised to manage his club's teams.
/// AFTT credentials are never persisted; only the verified identity is stored.
model CaptainAccount {
  id             String   @id @default(cuid())
  uniqueIndex    Int      @unique
  clubIndex      String
  firstName      String?
  lastName       String?
  ranking        String?
  lastVerifiedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([clubIndex])
}

model AvailabilityPoll {
  id            String                 @id @default(cuid())
  matchUniqueId Int
  teamId        String
  clubIndex     String
  createdBy     Int
  responses     AvailabilityResponse[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([matchUniqueId, clubIndex])
  @@index([clubIndex])
  @@index([teamId])
}

model AvailabilityResponse {
  id          String             @id @default(cuid())
  pollId      String
  poll        AvailabilityPoll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  uniqueIndex Int
  status      AvailabilityStatus @default(PENDING)
  note        String?
  source      ResponseSource     @default(PLAYER)
  respondedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([pollId, uniqueIndex])
  @@index([uniqueIndex])
}

model Lineup {
  id                    String       @id @default(cuid())
  matchUniqueId         Int
  teamId                String
  clubIndex             String
  status                LineupStatus @default(A_FAIRE)
  forceSnapshot         Json?
  validation            Json?
  overrideJustification String?
  validatedAt           DateTime?
  createdBy             Int
  slots                 LineupSlot[]
  convocation           Convocation?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@unique([matchUniqueId, clubIndex])
  @@index([clubIndex])
  @@index([teamId])
}

model LineupSlot {
  id          String   @id @default(cuid())
  lineupId    String
  lineup      Lineup   @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  uniqueIndex Int
  orderPos    Int // 1..4 titulaires, >100 banc
  role        SlotRole @default(TITULAIRE)
  createdAt   DateTime @default(now())

  @@unique([lineupId, uniqueIndex])
  @@index([lineupId])
}

model Convocation {
  id                   String                @id @default(cuid())
  lineupId             String                @unique
  lineup               Lineup                @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  matchUniqueId        Int
  message              String
  meetingTime          String?
  venue                String?
  publicTokenHash      String                @unique @map("publicToken")
  publicTokenExpiresAt DateTime?
  sentBy               Int
  responses            ConvocationResponse[]
  sentAt               DateTime              @default(now())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([matchUniqueId])
}

model ConvocationResponse {
  id            String            @id @default(cuid())
  convocationId String
  convocation   Convocation       @relation(fields: [convocationId], references: [id], onDelete: Cascade)
  uniqueIndex   Int
  status        ConvocationStatus @default(PENDING)
  source        ResponseSource    @default(PLAYER)
  respondedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([convocationId, uniqueIndex])
  @@index([uniqueIndex])
}

// ---------------------------------------------------------------------------
// Community challenges
// Unofficial, configurable ranking competitions published on a delayed cycle.
// Draft and press-final runs stay private until a ChallengePublication points
// at the validated Monday run on the following Thursday.
// ---------------------------------------------------------------------------

enum ChallengeRunType {
  SUNDAY_PRESS_DRAFT
  MONDAY_PRESS_FINAL
}

enum ChallengeRunStatus {
  RUNNING
  COMPUTED
  PRESS_SENT
  READY_FOR_PUBLICATION
  PUBLISHED
  FAILED
  DELIVERY_UNKNOWN
}

enum ChallengePressDeliveryStatus {
  PENDING
  SENT
  FAILED
  UNKNOWN
}

model Challenge {
  id                String                     @id @default(cuid())
  slug              String                     @unique
  name              String
  shortName         String?
  description       String?
  unofficial        Boolean                    @default(true)
  unofficialLabel   String                     @default("Classement non officiel")
  active            Boolean                    @default(false)
  displayOrder      Int                        @default(0)
  pressEmailSubject String?
  pressEmailBody    String?
  integrationConfig Json?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  seasons           ChallengeSeason[]
  secretReferences  ChallengeSecretReference[]
}

model ChallengeSecretReference {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  key         String
  envVarName  String
  required    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([challengeId, key])
}

model ChallengeSeason {
  id                  String                      @id @default(cuid())
  challengeId         String
  challenge           Challenge                   @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  season              Int
  rulesVersion        String
  timezone            String                      @default("Europe/Brussels")
  sundayRunTime       String                      @default("18:00")
  mondayRunTime       String                      @default("20:00")
  thursdayPublishTime String                      @default("08:00")
  pressRankingLimit   Int?
  active              Boolean                     @default(false)
  startsOn            DateTime                    @db.Date
  endsOn              DateTime                    @db.Date
  regions             ChallengeRegion[]
  clubs               ChallengeClub[]
  levels              ChallengeLevel[]
  divisions           ChallengeDivision[]
  pointOverrides      ChallengePointOverride[]
  excludedPlayers     ChallengeExcludedPlayer[]
  pressRecipients     ChallengePressRecipient[]
  rules               ChallengeRule[]
  championshipWeeks   ChallengeChampionshipWeek[]
  publications        ChallengePublication[]
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@unique([challengeId, season])
  @@index([season, active])
}

model ChallengeRule {
  id          String          @id @default(cuid())
  seasonId    String
  season      ChallengeSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  key         String
  value       Json
  description String?

  @@unique([seasonId, key])
}

model ChallengeRegion {
  id           String          @id @default(cuid())
  seasonId     String
  season       ChallengeSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  code         String
  label        String
  displayOrder Int             @default(0)
  clubs        ChallengeClub[]

  @@unique([seasonId, code])
}

model ChallengeClub {
  id        String          @id @default(cuid())
  seasonId  String
  season    ChallengeSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  regionId  String
  region    ChallengeRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)
  clubIndex String
  clubName  String?

  @@unique([seasonId, clubIndex])
  @@index([regionId])
}

model ChallengeLevel {
  id           String              @id @default(cuid())
  seasonId     String
  season       ChallengeSeason     @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  code         String
  label        String
  displayOrder Int                 @default(0)
  divisions    ChallengeDivision[]

  @@unique([seasonId, code])
}

model ChallengeDivision {
  id         String          @id @default(cuid())
  seasonId   String
  season     ChallengeSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  levelId    String
  level      ChallengeLevel  @relation(fields: [levelId], references: [id], onDelete: Cascade)
  divisionId Int

  @@unique([seasonId, divisionId])
  @@index([levelId])
}

model ChallengePointOverride {
  id                String          @id @default(cuid())
  seasonId          String
  season            ChallengeSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  playerUniqueIndex Int
  week              Int
  victoryCount      Int?
  forfeit           Int?
  reason            String?

  @@unique([seasonId, playerUniqueIndex, week])
}

model ChallengeExcludedPlayer {
  id                String          @id @default(cuid())
  seasonId          String
  season            ChallengeSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  playerUniqueIndex Int
  reason            String?

  @@unique([seasonId, playerUniqueIndex])
}

model ChallengePressRecipient {
  id       String          @id @default(cuid())
  seasonId String
  season   ChallengeSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  email    String
  name     String?
  active   Boolean         @default(true)

  @@unique([seasonId, email])
}

model ChallengeChampionshipWeek {
  id                  String                @id @default(cuid())
  seasonId            String
  season              ChallengeSeason       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  week                Int
  championshipSunday  DateTime              @db.Date
  mondayRunDate       DateTime              @db.Date
  thursdayPublishDate DateTime              @db.Date
  source              String?
  active              Boolean               @default(true)
  runs                ChallengeRun[]
  publication         ChallengePublication?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([seasonId, week])
  @@unique([seasonId, championshipSunday])
  @@unique([seasonId, mondayRunDate])
  @@unique([seasonId, thursdayPublishDate])
}

model ChallengeRun {
  id                 String                    @id @default(cuid())
  championshipWeekId String
  championshipWeek   ChallengeChampionshipWeek @relation(fields: [championshipWeekId], references: [id], onDelete: Cascade)
  type               ChallengeRunType
  status             ChallengeRunStatus        @default(RUNNING)
  attempt            Int                       @default(1)
  sourceVersion      String
  checksum           String?
  totalPlayers       Int                       @default(0)
  totalRankings      Int                       @default(0)
  startedAt          DateTime                  @default(now())
  computedAt         DateTime?
  pressSentAt        DateTime?
  publishedAt        DateTime?
  completedAt        DateTime?
  failureReason      String?
  rankings           ChallengeRanking[]
  playerPoints       ChallengePlayerPoint[]
  regionSummaries    ChallengeRegionSummary[]
  pressDelivery      ChallengePressDelivery?
  publication        ChallengePublication?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@unique([championshipWeekId, type, attempt])
  @@index([championshipWeekId, type, status])
}

model ChallengeRanking {
  id                String       @id @default(cuid())
  runId             String
  run               ChallengeRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  playerUniqueIndex Int
  playerName        String
  clubIndex         String
  clubName          String
  regionCode        String
  regionLabel       String
  levelCode         String
  levelLabel        String
  position          Int
  totalParticipants Int
  points            Int
  count5Pts         Int          @default(0)
  count3Pts         Int          @default(0)
  count2Pts         Int          @default(0)
  count1Pts         Int          @default(0)
  count0Pts         Int          @default(0)
  createdAt         DateTime     @default(now())

  @@unique([runId, playerUniqueIndex])
  @@unique([runId, regionCode, levelCode, position])
  @@index([runId, regionCode, levelCode, position])
  @@index([playerUniqueIndex, runId])
}

model ChallengePlayerPoint {
  id                String       @id @default(cuid())
  runId             String
  run               ChallengeRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  playerUniqueIndex Int
  matchUniqueId     Int
  matchId           String
  divisionId        Int
  week              Int
  levelCode         String
  victoryCount      Int
  forfeit           Int
  pointsWon         Int
  createdAt         DateTime     @default(now())

  @@unique([runId, playerUniqueIndex, matchUniqueId])
  @@index([playerUniqueIndex, runId, week])
}

model ChallengeRegionSummary {
  id             String       @id @default(cuid())
  runId          String
  run            ChallengeRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  regionCode     String
  regionLabel    String
  totalPlayers   Int
  playersByLevel Json
  clubs          String[]
  aiSummary      Json?
  createdAt      DateTime     @default(now())

  @@unique([runId, regionCode])
}

model ChallengePressDelivery {
  id                String                       @id @default(cuid())
  runId             String                       @unique
  run               ChallengeRun                 @relation(fields: [runId], references: [id], onDelete: Cascade)
  status            ChallengePressDeliveryStatus @default(PENDING)
  providerMessageId String?
  attemptCount      Int                          @default(0)
  sentAt            DateTime?
  lastError         String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
}

model ChallengePublication {
  id                 String                    @id @default(cuid())
  seasonId           String
  season             ChallengeSeason           @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  championshipWeekId String                    @unique
  championshipWeek   ChallengeChampionshipWeek @relation(fields: [championshipWeekId], references: [id], onDelete: Cascade)
  runId              String                    @unique
  run                ChallengeRun              @relation(fields: [runId], references: [id], onDelete: Restrict)
  publishedAt        DateTime                  @default(now())

  @@unique([seasonId, championshipWeekId])
  @@index([seasonId, publishedAt])
}
